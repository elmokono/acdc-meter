{
    "configurations": [
        {
            "name": "ESP8266",
            "includePath": [
                "${workspaceFolder}/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp8266/hardware/esp8266/**",
                "${env:LOCALAPPDATA}/Arduino15/packages/esp8266/tools/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_ARCH_ESP8266",
                "ESP8266",
                "ARDUINO_ESP8266_WEMOS_D1MINI"
            ],
            "intelliSenseMode": "windows-gcc-x64",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}